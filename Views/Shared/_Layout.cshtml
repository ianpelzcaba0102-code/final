<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Talleres extracurriculares</title>
    <link rel="stylesheet" href="@Url.Content("~/css/estilos.css")" />
</head>
<body>
    <header class="site-header">
        <div class="site-header-content">
            <h1>Talleres extracurriculares</h1>
            <nav aria-label="Navegación principal">
                <ul>
                    <li><a href="@Url.Action("Catalogo", "Taller")">Catálogo</a></li>
                    <li><a href="@Url.Action("MisInscripciones", "Taller")">Mis inscripciones</a></li>
                    <li><a href="@Url.Action("CerrarSesion", "Cuenta")">Cerrar sesión</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year Talleres extracurriculares</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
