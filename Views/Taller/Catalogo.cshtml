@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Catálogo";
}

<h1>Catálogo</h1>

@if (!Model.Any())
{
    <p>No hay talleres disponibles en este momento.</p>
}
else
{
    <div class="taller-grid">
        @foreach (dynamic taller in Model)
        {
            <a class="taller-card" href="@Url.Action("Detalle", "Taller", new { id = taller.Id })">
                <img src="@Url.Content("~/imagenes/" + taller.Imagen)" alt="@taller.Nombre" />
                <div class="taller-card-content">
                    <h2>@taller.Nombre</h2>
                    <p class="taller-category">@taller.NombreCategoria</p>
                </div>
            </a>
        }
    </div>
}

<button type="button" class="btn btn-primary">Ver más</button>
