@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Catálogo";
}

<h1>Catálogo</h1>

@if (ViewBag.ErrorCatalogo is not null)
{
    <p class="text-danger" role="alert">@ViewBag.ErrorCatalogo</p>
}

@if (!Model.Any())
{
    <p>No hay talleres disponibles en este momento.</p>
}
else
{
    <div class="taller-grid" id="talleres">
        @foreach (dynamic taller in Model)
        {
            <a class="taller-card" href="@Url.Action("Detalle", "Taller", new { id = taller.Id })">
                <img src="@Url.Content("~/imagenes/" + taller.Imagen)" alt="@taller.Nombre" />
                <div class="taller-card-content">
                    <h2>@taller.Nombre</h2>
                    <p class="taller-category">@taller.NombreCategoria</p>
                </div>
            </a>
        }
    </div>
}

@if (ViewBag.HayMas)
{
    <button type="button"
            class="btn btn-primary"
            id="verMas"
            data-url-ver-mas="@Url.Action("VerMas", "Taller")"
            data-url-detalle="@Url.Action("Detalle", "Taller")"
            data-ruta-imagenes="@Url.Content("~/imagenes/")">
        Ver más
    </button>
}
<p id="errorVerMas" class="text-danger" role="alert"></p>

@section Scripts {
    <script src="~/js/catalogo.js"></script>
}
