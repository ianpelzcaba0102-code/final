@{
    ViewData["Title"] = "Detalle del taller";
    dynamic taller = ViewBag.Taller;
    IEnumerable<dynamic> encuentros = ViewBag.Encuentros;
}

<h1>@taller.Nombre</h1>

<section class="taller-detalle">
    <img src="@Url.Content("~/imagenes/" + taller.Imagen)" alt="@taller.Nombre" />
    <p><strong>ID:</strong> @taller.Id</p>
    <p><strong>Descripción:</strong> @taller.Descripcion</p>
    <p><strong>Imagen:</strong> @taller.Imagen</p>
    <p><strong>ID de categoría:</strong> @taller.IdCategoria</p>
    <p><strong>Categoría:</strong> @taller.NombreCategoria</p>
    <p><strong>Activo:</strong> @taller.Activo</p>
</section>

<h2>Próximos encuentros</h2>

@if (ViewBag.ErrorInscripcion is not null)
{
    <p class="text-danger" role="alert">@ViewBag.ErrorInscripcion</p>
}
@if (ViewBag.MensajeInscripcion is not null)
{
    <p role="status">@ViewBag.MensajeInscripcion</p>
}

@if (!encuentros.Any())
{
    <p>No hay encuentros futuros para este taller.</p>
}
else
{
    <form asp-controller="Taller" asp-action="Inscribirse" method="post">
    <ul>
        @foreach (dynamic encuentro in encuentros)
        {
            <li>
                <label>
                    <input type="radio"
                           name="IdEncuentro"
                           value="@encuentro.Id"
                           class="encuentro-radio"
                           required />
                    @(((DateTime)encuentro.FechaHora).ToString("dd/MM/yyyy"))
                    a las @(((DateTime)encuentro.FechaHora).ToString("HH:mm")) —
                    @encuentro.DuracionMinutos minutos, cupo @encuentro.Cupo
                </label>
            </li>
        }
    </ul>
        <button type="submit" class="btn btn-primary">Inscribirme</button>
    </form>
}

<div id="lugaresDisponibles"
     data-url="@Url.Action("LugaresDisponibles", "Taller")"
     aria-live="polite"></div>

@section Scripts {
    <script src="~/js/detalle.js"></script>
}
