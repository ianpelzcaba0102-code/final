@{
    ViewData["Title"] = "Detalle del taller";
    dynamic taller = ViewBag.Taller;
    IEnumerable<dynamic> encuentros = ViewBag.Encuentros;
}

<h1>@taller.Nombre</h1>

<section class="taller-detalle">
    <img src="@Url.Content("~/imagenes/" + taller.Imagen)" alt="@taller.Nombre" />
    <p><strong>ID:</strong> @taller.Id</p>
    <p><strong>Descripción:</strong> @taller.Descripcion</p>
    <p><strong>Imagen:</strong> @taller.Imagen</p>
    <p><strong>ID de categoría:</strong> @taller.IdCategoria</p>
    <p><strong>Categoría:</strong> @taller.NombreCategoria</p>
    <p><strong>Activo:</strong> @taller.Activo</p>
</section>

<h2>Próximos encuentros</h2>

@if (!encuentros.Any())
{
    <p>No hay encuentros futuros para este taller.</p>
}
else
{
    <ul>
        @foreach (dynamic encuentro in encuentros)
        {
            <li>
                <label>
                    <input type="radio"
                           name="IdEncuentro"
                           value="@encuentro.Id"
                           class="encuentro-radio" />
                    @(((DateTime)encuentro.FechaHora).ToString("dd/MM/yyyy"))
                    a las @(((DateTime)encuentro.FechaHora).ToString("HH:mm")) —
                    @encuentro.DuracionMinutos minutos, cupo @encuentro.Cupo
                </label>
            </li>
        }
    </ul>
}

<div id="lugaresDisponibles" aria-live="polite"></div>

@section Scripts {
    <script>
        const radiosEncuentro = document.querySelectorAll(".encuentro-radio");
        const resultadoLugares = document.getElementById("lugaresDisponibles");
        const urlLugaresDisponibles = "@Url.Action("LugaresDisponibles", "Taller")";

        for (const radio of radiosEncuentro) {
            radio.addEventListener("change", async function () {
                resultadoLugares.innerHTML = "Consultando lugares disponibles...";

                try {
                    const respuesta = await fetch(
                        `${urlLugaresDisponibles}?idEncuentro=${encodeURIComponent(radio.value)}`
                    );

                    if (!respuesta.ok) {
                        throw new Error("No se pudieron consultar los lugares disponibles.");
                    }

                    const datos = await respuesta.json();
                    resultadoLugares.innerHTML =
                        `Lugares disponibles: <strong>${datos.lugaresDisponibles}</strong>`;
                } catch (error) {
                    resultadoLugares.innerHTML = error.message;
                }
            });
        }
    </script>
}
