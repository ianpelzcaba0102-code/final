@{
    ViewData["Title"] = "Registro";
}

<h1>Registro</h1>

<form asp-controller="Cuenta" asp-action="Registro" method="post" id="registroForm">
    <div class="mb-3">
        <label for="NombreUsuario" class="form-label">Nombre de usuario</label>
        <input type="text" id="NombreUsuario" name="NombreUsuario" maxlength="50" class="form-control" />
    </div>
    <div class="mb-3">
        <label for="Contrasena" class="form-label">Contraseña</label>
        <input type="password" id="Contrasena" name="Contrasena" maxlength="50" class="form-control" />
    </div>
    <div class="mb-3">
        <label for="Nombre" class="form-label">Nombre</label>
        <input type="text" id="Nombre" name="Nombre" maxlength="50" class="form-control" />
    </div>
    <div class="mb-3">
        <label for="Apellido" class="form-label">Apellido</label>
        <input type="text" id="Apellido" name="Apellido" maxlength="50" class="form-control" />
    </div>

    <div id="erroresValidacion" class="text-danger" role="alert"></div>
    <div class="text-danger" role="alert">@ViewBag.Error</div>

    <button type="submit" class="btn btn-primary">Registrarse</button>
</form>

@section Scripts {
    <script src="~/js/registro.js"></script>
}
